{
  "name": "hmdlohar-portfolio",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun check && bun build.tsx && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "dev": "bun --watch build.tsx --serve & tailwindcss -i src/styles.css -o dist/styles.css --watch=always",
    "check": "bun check"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.3",
    "tailwindcss": "^4.3.3"
  }
}
